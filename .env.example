# Copia este archivo a .env y ajústalo, o exporta estas variables en tu shell.

# Credenciales de la interfaz web. Si no defines CIBERNAV_PASS, la app genera
# una contraseña aleatoria por sesión y la muestra por consola al arrancar.
CIBERNAV_USER=admin
CIBERNAV_PASS=cambia-esta-contrasena

# Rutas de datos (por defecto /tmp/cibernav y ./db/cibernav.db)
# CIBERNAV_DATA_DIR=/tmp/cibernav
# CIBERNAV_DB_PATH=./db/cibernav.db

# Diccionario para cracking (Kali trae rockyou en esta ruta)
# CIBERNAV_WORDLIST=/usr/share/wordlists/rockyou.txt

# Bettercap (opcional)
# BETTERCAP_API_URL=http://127.0.0.1:8081
# BETTERCAP_API_USER=cibernav
# BETTERCAP_API_PASS=

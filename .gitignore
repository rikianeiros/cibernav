# --- Entorno Python ---
# El entorno virtual pesa ~500MB y es específico de cada máquina.
# Cada máquina lo genera con setup.sh
venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# --- Base de datos ---
# Contiene datos reales de escaneos e inteligencia naval.
# NUNCA debe subirse a un repositorio.
db/

# --- Archivos de Captura Wi-Fi ---
# Archivos .cap y .pcap con handshakes WPA2 capturados.
# Son material sensible de auditoría.
*.cap
*.pcap
*.pcapng

# --- Logs y temporales ---
*.log
*.tmp

# --- Sistema Operativo ---
.DS_Store
Thumbs.db

# --- IDEs ---
.vscode/
.idea/
*.swp
